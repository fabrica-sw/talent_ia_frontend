          <mxGeometry x="635" y="42" width="280" height="72" as="geometry" />
        </mxCell>

        <mxCell id="db_audit" value="&lt;b&gt;Tabla: log_auditoria (Inmutable)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot; color=&quot;#334155&quot;&gt;usuario_id, usuario_email, ip_address, accion, modulo, nivel (INFO/WARN/ERROR/CRITICAL), detalles JSONB, fecha DESC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#1e293b;fontSize=9.5;" vertex="1" parent="group_database">
          <mxGeometry x="25" y="128" width="585" height="46" as="geometry" />
        </mxCell>

