        <mxCell id="db_auth" value="&lt;b&gt;Tabla: auth_users &amp;amp; app_users&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot; color=&quot;#334155&quot;&gt;UUID, email UNIQUE, password_hash bcrypt, reset_code, rol RBAC, activo, primer_login, trigger sync&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#16a34a;fontColor=#1e293b;fontSize=9.5;" vertex="1" parent="group_database">
